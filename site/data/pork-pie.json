  "receipts": [
    {
      "receiptId": "pork-pie.html-1",
      "receiptSource": "Original Receipt from \u0027\u003Ci\u003EThe Cook\u0027s and Confectioners Dictionary\u003C/i\u003E by John Nott (\u003Ca href=\u0022references.html#nott-1723\u0022\u003E\u003Cb\u003ENott 1723\u003C/b\u003E\u003C/a\u003E)",
      "receiptText": "\u003Cb\u003ETo Make a Pork Pye\u003C/b\u003E\u003Cbr\u003E\nTake the Skin off your Pork, cut it into Stakes, season it pretty well with Salt Nutmeg slic\u0027d and beaten, Pepper, put in also Pippins cut into small pieces as many as you think convenient and sweeten with Sugar to your Palate, put in half a Pint of White wine, lay Butter all over it, close up your Pye and set it into the Oven.\u003Cbr\u003E"
    }
  ],
