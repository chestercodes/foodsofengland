  "receipts": [
    {
      "receiptId": "nottingham-batter-pudding.html-1",
      "receiptSource": "Original Receipt in \u0027\u003Ci\u003EThe Cook and Housekeeper\u0027s Dictionary\u003C/i\u003E\u0027 by Mary Eaton (\u003Ca href=\u0022references.html#eaton-1822\u0022\u003E\u003Cb\u003EEaton 1822\u003C/b\u003E\u003C/a\u003E);",
      "receiptText": "NOTTINGHAM PUDDING. Peel six large apples, take out the core with the point of a small knife or an apple scoop, but the fruit must be left whole. Fill up the centre with sugar, place the fruit in a pie dish, and pour over a nice light batter, prepared as for batter pudding, and bake it an hour in a moderate oven.\u003Cbr\u003E"
    },
    {
      "receiptId": "nottingham-batter-pudding.html-2",
      "receiptSource": "Original Receipt from \u0027\u003Ci\u003EThe Cook\u0027s Oracle\u003C/i\u003E\u0027 by William Kitchiner (\u003Ca href=\u0022references.html#kitchiner-1830\u0022\u003E\u003Cb\u003EKitchiner 1830\u003C/b\u003E\u003C/a\u003E)",
      "receiptText": "\u003Ci\u003E\u003Cb\u003ENottingham Pudding.\u003C/b\u003E\u003C/i\u003E\u003Cbr\u003E\nPeel six good apples; take out the core with the point of a small knife, or an apple corer, if you have one; but be sure to leave the apples whole; fill up where you took the core from with sugar; place them in a pie-dish, and pour over them a nice light batter, prepared as for batter pudding, and bake an hour in a moderate oven.\u003Cbr\u003E"
    }
  ],
