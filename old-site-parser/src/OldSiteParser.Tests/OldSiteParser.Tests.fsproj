<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Shared/KebabTests.fs" />
    <Compile Include="Shared/HtmlParsingTests.fs" />
    <Compile Include="Steps/Step1Tests.fs" />
    <Compile Include="Steps/Step2Tests.fs" />
    <Compile Include="Steps/Step3Tests.fs" />
    <Compile Include="Steps/Step4Tests.fs" />
    <Compile Include="Steps/Step6Tests.fs" />
    <Compile Include="Steps/Step7Tests.fs" />
    <Compile Include="Steps/Step8Tests.fs" />
    <Compile Include="Integration/PipelineTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Steps/Step4Files/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Steps/Step6Files/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Steps\Step4Files\**\*.verified.*" />
    <None Include="Steps\Step6Files\**\*.verified.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Verify.XunitV3" Version="31.12.5" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OldSiteParser\OldSiteParser.fsproj" />
  </ItemGroup>

</Project>